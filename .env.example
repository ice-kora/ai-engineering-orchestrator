# ============================================================
# ai-engineering-orchestrator 环境变量模板
# 复制为 .env 后填写；.env 已被 .gitignore 排除，严禁提交真实密钥
# P0 阶段全部为占位符；P2 (Model Router) 才实际消费
# ============================================================

# --- Model Router (P2) ---
# Primary: OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ORCHESTRATOR_PRIMARY_MODEL=gpt-main

# Fallback A: 自定义 OpenAI-compatible Provider (GLM/DeepSeek/...)
FALLBACK_A_API_KEY=
FALLBACK_A_BASE_URL=
FALLBACK_A_MODEL=

# Fallback B: 其他可工具调用 Provider
FALLBACK_B_API_KEY=
FALLBACK_B_BASE_URL=
FALLBACK_B_MODEL=

# --- Agent Mail (安装后按实际部署填写) ---
AGENT_MAIL_HTTP_URL=http://127.0.0.1:8765/mcp/
AGENT_MAIL_HTTP_TOKEN=
AGENT_MAIL_STORAGE_ROOT=D:\Software\ai-orchestrator\agent-mail\storage

# --- Antigravity headless (CI 模式；交互模式用 OAuth 登录，无需此键) ---
GEMINI_API_KEY=

# --- 共享缓存 (v1.1 §7.2, D 盘约束) ---
PNPM_STORE_DIR=D:\Software\ai-orchestrator\shared-cache\.pnpm-store
MAVEN_REPO_LOCAL=D:\Software\ai-orchestrator\shared-cache\.m2\repository
